{
  "name": "staybridge-tokyo-acceptance",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "description": "Independent black-box acceptance and evidence suite for StayBridge Tokyo",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:release": "playwright test --project=functional --grep @release",
    "test": "playwright test --project=functional",
    "test:evidence": "playwright test --project=evidence-mobile --project=evidence-admin --grep @evidence",
    "test:evidence:mobile": "playwright test --project=evidence-mobile --grep @evidence",
    "test:evidence:admin": "playwright test --project=evidence-admin --grep @evidence",
    "test:headed": "playwright test --project=functional --headed",
    "test:ui": "playwright test --ui",
    "test:persona": "playwright test e2e/persona-a --project=functional",
    "test:crisis": "playwright test e2e/crisis --project=functional",
    "check:overlay": "tsx scripts/check-overlay-isolation.ts",
    "evidence:matrix": "tsx scripts/generate-evidence-matrix.ts",
    "report": "playwright show-report evidence/reports/html"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.17.1",
    "dotenv": "^17.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
